{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@casual-game-world/shared": [
        "packages/shared/src/index.ts"
      ],
      "@casual-game-world/game-sdk": [
        "packages/game-sdk/src/index.ts"
      ]
    }
  }
}

